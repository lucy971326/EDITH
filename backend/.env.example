# ---------- Models ----------
# 这两个 Key 当前都是启动后端所必需的。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# MiniMax可以用TokenPlan的APIKEY
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ---------- Tools ----------
# GitHub MCP 使用的 Personal Access Token。
GITHUB_TOKEN=

# ---------- Sandbox ----------
# local: 本地工作区（开发默认）
# e2b:   E2B 云沙箱
SANDBOX_MODE=local

# 仅当 SANDBOX_MODE=e2b 时需要。
E2B_API_KEY=
E2B_DOMAIN=
E2B_TEMPLATE=edith-v0-1-0

# ---------- Server ----------
ADDR=127.0.0.1:8080

# ---------- Telegram ----------
# 配置用户自己的 Bot 时，后端会以此地址注册 Webhook。
# 例如：https://your-ngrok-domain.ngrok-free.app
TELEGRAM_WEBHOOK_BASE_URL=

# 本地访问 Telegram API 需要代理时填写；不需要则留空。
TELEGRAM_PROXY=
